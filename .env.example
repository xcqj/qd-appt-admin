# 号源 QueueDepth · 管理后台环境变量模板（S14）
#
# 分两类，别混：
#   A. 构建期（VITE_*）：打包时写入产物，改了要重新 build；本仓 .env.development / .env.production 已有可用值
#   B. 运行期（APPT_*）：容器启动时生效，改完只需重启容器（nginx 模板用 envsubst 注入）
#
# 取值位置：VITE_* 由 src/utils/request.ts、src/utils/push.ts 读取；APPT_* 由 docker/nginx/default.conf.template 读取。

# ---------------------------------------------------------------- A. 构建期
# 接口前缀。生产构建默认 /prod-api（与 nginx 反代的 location 对应）；开发态 /dev-api 走 vite 代理
# 生效位置：src/utils/request.ts `baseURL`、src/utils/push.ts SSE 地址、docker/nginx 模板的 location
VITE_APP_BASE_API=/prod-api

# 客户端 id（sys_client 表的 pc 行）。改错表现为登录报「客户端校验失败」或无权限
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

# 接口加解密开关，必须与后端 api-decrypt.enabled 同开同关
# true  → 登录请求带 encrypt-key（RSA 加密的 AES key），体为 base64(AES(json))
# false → 明文；错配表现为 403 或 JSON 解析失败
VITE_APP_ENCRYPT=true

# RSA 公钥（前端加密用）与私钥（响应解密用）；与后端配置成对，仅演示固定值
VITE_APP_RSA_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDvEDuRIOM3oZPWj9Ukoc5pQklR4PFH6/clnjeFqjDLIgDyQvjxhgqAZQA+E9eD6qu6FsXPmK8djcL+nh3cFHz4pX473jDvO3Sve+8yL3VRQ0n2pRgQ2a01MJsy+WwTZCBYWf0VnLRIvANUoWQgy9vz94q7Va44dg7A1/3ICf+xAwIDAQAB
VITE_APP_RSA_PRIVATE_KEY=

# 可选：站点标题 / 端口 / 子路径
VITE_APP_TITLE=号源预约挂号管理后台
VITE_APP_PORT=8083
VITE_APP_CONTEXT_PATH=/

# ---------------------------------------------------------------- 开发期（pnpm dev）
# vite 代理目标。默认 http://localhost:8082；截图脚本指向关验证码的 18082
# 生效位置：vite.config.ts `server.proxy[VITE_APP_BASE_API].target`
VITE_PROXY_TARGET=http://localhost:8082

# ---------------------------------------------------------------- B. 运行期（容器）
# 后端上游地址；默认值只在 compose 网络内可用（服务名 api）
# 独立 `docker run` 时改成宿主机可达地址，例如 http://172.17.0.1:8082
# 生效位置：docker/nginx/default.conf.template 的 `proxy_pass ${APPT_API_UPSTREAM}/`
APPT_API_UPSTREAM=http://api:8082

# SnailJob 控制台地址（后台「运维对账 → 任务调度中心」的 iframe，反代 /snail-job/）
# demo compose 会起 appt-snailjob 服务（容器内 8800），故默认指向服务名；
# 想改看宿主机上的实例时改成 http://host.docker.internal:8800
APPT_SNAILJOB_UPSTREAM=http://snailjob:8800
